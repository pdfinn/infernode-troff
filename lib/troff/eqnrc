define coth @type op roman "coth"@
define arcsin @type op roman "arcsin"@
define arccos @type op roman "arccos"@
define arctan @type op roman "arctan"@
define exp @type op roman "exp"@
define log @type op roman "log"@
define ln @type op roman "ln"@
define lg @type op roman "lg"@
define lim @type op roman "lim"@
define max @type op roman "max"@
define min @type op roman "min"@
define det @type op roman "det"@
define gcd @type op roman "gcd"@
define arg @type op roman "arg"@
define deg @type op roman "deg"@
define dim @type op roman "dim"@
define hom @type op roman "hom"@
define ker @type op roman "ker"@
define Pr @type op roman "Pr"@
.EN
