.\" eqnrc - eqn(1)'s settings for Libertinus Math: read before a
.\" document's equations (book(1) puts it first when there are any)
.\"
.\" What is TeX's, whatever the font: its rules for atoms, styles,
.\" fractions, arrays, accents and delimiters (set tex_...), maths italic
.\" letters, sizes in hundredths of a point (scaled_sizes), its classes
.\" for characters (! and ? closing, . ordinary, : a relation), and the
.\" names of functions as operators (a thin space each side, none before a
.\" parenthesis; limits under lim and max in a display). What is the
.\" font's, after it: its MATH table, as mkfn -M writes it; for another
.\" OpenType math font mounted as S, put mkfn -M's for it there instead.
.\"
.\" the mathematical symbols the text fonts lack, from the math font
.fspecial R S
.fspecial I S
.fspecial B S
.EQ
set text_limits 1
set tex_script_drop 1
set tex_arrays 1
set script_kern 0
set over_hang 0
set null_delimiter_space 11
set tex_atoms 1
set tex_greek 1
gsfont S
set fraction_ord 1
set math_italic 1
set tex_accents 1
set tex_fractions 1
set scaled_sizes 1
set delimiter_factor 901
set delimiter_shortfall 45
chartype close "!"
chartype close "?"
chartype ord "."
chartype rel ":"
define sin @{type op roman "sin"}@
define cos @{type op roman "cos"}@
define tan @{type op roman "tan"}@
define cot @{type op roman "cot"}@
define sec @{type op roman "sec"}@
define csc @{type op roman "csc"}@
define sinh @{type op roman "sinh"}@
define cosh @{type op roman "cosh"}@
define tanh @{type op roman "tanh"}@
define coth @{type op roman "coth"}@
define arcsin @{type op roman "arcsin"}@
define arccos @{type op roman "arccos"}@
define arctan @{type op roman "arctan"}@
define exp @{type op roman "exp"}@
define log @{type op roman "log"}@
define ln @{type op roman "ln"}@
define lg @{type op roman "lg"}@
define lim @{type op roman "lim"}@
define max @{type op roman "max"}@
define min @{type op roman "min"}@
define det @{type op roman "det"}@
define gcd @{type op roman "gcd"}@
define arg @{type op roman "arg"}@
define deg @{type op roman "deg"}@
define dim @{type op roman "dim"}@
define hom @{type op roman "hom"}@
define ker @{type op roman "ker"}@
define Pr @{type op roman "Pr"}@
.EN
