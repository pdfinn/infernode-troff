.\" tmac.book: a book (troff -mbook)
.\"
.\" Semantic macros, each one of LaTeX's, so that a book written with
.\" them is readily turned into LaTeX:
.\"
.\"	.title T  .subtitle S  .author A  .date D  .maketitle
.\"	.frontmatter  .mainmatter  .backmatter
.\"	.part "Title"
.\"	.chapter "Title" [label]	.chapter* "Title"	(unnumbered)
.\"	.section "Title" [label]	.subsection "Title" [label]
.\"	a blank line, or .p		a paragraph
.\"	.quote ... .endquote		a block quotation
.\"	.epigraph ... .attrib "Source" .endepigraph
.\"	text\*[fnmark] then .fn ... .fe	a footnote (.fn alone marks the
.\"					text before if it ended with \c,
.\"					as refer's notes do)
.\"	text\*[enmark] then .en ... .ee	an endnote; .notes prints them
.\"	.label name, \*[ref name], \*[pageref name]	(the second pass's)
.\"	.contents			the table of contents (the second pass's)
.\"	.cite key loc			refer -S chicago's notes; .bibliography
.\"	.index "term!sub|see{other}"	an index entry, as makeindex's;
.\"	.printindex			the index (mkindex(1)'s, the
.\"					second pass's), in two columns
.\"
.\" The PDF (tr2pdf's) is read on a screen too: the contents' lines,
.\" references, notes' marks and the index's pages are links where they
.\" lead, the headings bookmarks, the pages labelled as numbered.  It is
.\" tagged (x X tag), for those who hear it read or reflow it: its
.\" headings, paragraphs, quotations, notes, contents, bibliography and
.\" index are its structure, read in order; its running heads and folios
.\" are not.  .alt "text" describes the next picture (pic's) for those
.\" who cannot see it; the string book-lang is its language (en).
.\"
.\" The page: .papersize W H (6i 9i), .margins top bottom inner outer;
.\" the type: registers book-ps (point size, in points) and book-vs.
.\" Set them before the first text. Greek is hyphenated as Greek.
.\"
.\" The second pass: a book's table of contents and its references are
.\" known only when it has been set once. Each is written to the
.\" standard error as a line beginning "aux:", and book(1) gathers them
.\" into the file the string book-aux names, read here.
.\"
.\" ---------------------------------------------------------------
.\" the page and the type
.\"
.nr book-ps 11		\" point size, in whole points
.nr book-vs 14p
.nr book-pw 6i
.nr book-ph 9i
.nr book-tm 0.75i	\" top margin, to the text
.nr book-bm 0.875i	\" bottom margin
.nr book-im 0.875i	\" inner (binding) margin
.nr book-om 0.75i	\" outer margin
.nr book-pi 1.5m	\" paragraph indent
.nr book-tvs 0		\" the contents' and lists' spacing (0: the text's)
.nr book-plain 0		\" no running heads, the folio at the foot (LaTeX's plain)
.nr book-chlatex 0		\" chapters headed as LaTeX's book class heads them
.nr book-oneside 0		\" one-sided: the binding margin on every page's left, one head
.nr book-nps 0		\" the notes' point size (0: the text's less 2)
.nr book-nvs 0		\" and their spacing (0: the text's less 2 points),
.\"			so that text set double (a thesis's) has its notes single
.nr book-recto 1	\" chapters open on a right-hand page
.\"
.\" the point size book-ps times $1/$2
.de book-size
.nr book-sz \\n[book-ps]*\\$1/\\$2
.ps \\n[book-sz]
..
.\" tagged PDF: an element of the structure, for tr2pdf (x X tag), given
.\" after a break, where the text before it has gone out; in a diversion,
.\" kept there, to be given when what was diverted goes out
.de book-tag
.ie '\\n[.z]'' .dv tag \\$*
.el \{\
\\!.book-tag \\$*
.\}
..
.ds book-lang en
.ds book-alt
.de alt
.ds book-alt \\$*
..
.\" the page: its width and height, or a name (a4, a5, b5, letter); a
.\" size no page could be is refused, said, and the page left as it was
.de papersize
.ie '\\$1'a4' .papersize 21c 29.7c
.el .ie '\\$1'a5' .papersize 14.8c 21c
.el .ie '\\$1'b5' .papersize 17.6c 25c
.el .ie '\\$1'letter' .papersize 8.5i 11i
.el .ie ((\\$1)<1i)+((\\$2)<1i) .tm book: .papersize \\$1 \\$2: not a page's size (a width and a height, or a4, a5, b5, letter)
.el \{\
.	nr book-pw (\\$1)
.	nr book-ph (\\$2)
.\}
..
.de margins
.if !'\\$1'' .nr book-tm (\\$1)
.if !'\\$2'' .nr book-bm (\\$2)
.if !'\\$3'' .nr book-im (\\$3)
.if !'\\$4'' .nr book-om (\\$4)
..
.\"
.\" hyphenation: English's patterns, and Ancient Greek's
.hpfa
.hpfa /lib/troff/hyph/grc.pat
.\"
.\" the fonts: R I B BI as the device has them; small capitals
.fp 11 SC R
.ff SC +smcp
.\" the fallback: a character none of Libertinus's fonts has is DejaVu
.\" Sans's (a special font, searched when the font set in lacks a glyph)
.fp 12 DF
.\" and a character none has is said, not dropped without a word
.mg 1
.\"
.\" rules (tbl's, \l's of \(ul, \L's) drawn as lines, not glyphs
.rules 1
.\"
.\" microtypography, for the book as it goes to press (book -f, which
.\" sets the register book-final): punctuation, hyphens, quotation marks
.\" and a few letters hang into the margins (protrusion), so the text's
.\" edges look straight; in thousandths of each glyph's width, after
.\" microtype's defaults.  And a justified line's glyphs may widen or
.\" narrow by up to 2%, in steps of 0.5% (expansion, .mte 20 20 5, as
.\" pdfTeX's are commonly set), so its spaces vary less.  Drafts are set
.\" without either.
.de book-mtpc
.mtpc \\$1 0 700 . \(hy - ‐
.mtpc \\$1 0 500 , : ;
.mtpc \\$1 0 200 ? ! ·
.mtpc \\$1 200 300 –
.mtpc \\$1 150 200 —
.mtpc \\$1 500 300 “ ‘ « ‹
.mtpc \\$1 300 500 ” ’ » › '
.mtpc \\$1 100 0 ( [
.mtpc \\$1 0 100 ) ]
.mtpc \\$1 50 50 A T V W X Y v w x y
.mtpc \\$1 0 50 F K L k r
.mtpc \\$1 0 70 t
..
.book-mtpc R
.book-mtpc I
.book-mtpc B
.book-mtpc BI
.\"
.\" ---------------------------------------------------------------
.\" lines: a paragraph's breaks chosen for the whole paragraph at once
.\" (.ad p, as TeX chooses them), not line by line; a space may shrink
.\" by a third (.ssh), as TeX's may, so a line need not be broken short
.\" and stretched; a hyphen costs as a loose line does (.hycost), a
.\" second in a row ten times as much, a fourth not allowed (.hlm); one
.\" space after a sentence, not two (.ss); three letters at least after
.\" a hyphen (.hy 5: not the last two, as English's \righthyphenmin).
.\" Measured on a book's prose against LuaLaTeX's with microtype: its
.\" spaces as even, as few lines loose, about as many hyphens.  Each
.\" environment has its own.
.ds book-adj pb	\" the text's adjustment: pl, ragged right (broken as pb's)
.de book-fill
.ad \\*[book-adj]
.hy 5
.ssh 33
.hycost 300 3000
.hlm 3
.ss 12 0
..
.\" pages flush at their foot, as LaTeX's \flushbottom makes them (tr2pdf's
.\" x X vstretch and vfoot): where space may stretch, and by how much
.\" with the others (LaTeX's: a point between paragraphs, more about
.\" headings and displays); at the foot, where a full page's last line
.\" is, on the lines from the top margin.  Not a chapter's last page, nor
.\" the index's columns.
.nr book-nofill 0
.nr book-fotrap 0
.\" book-keep set: the next such space (a display's, above it) not to
.\" stretch, the display kept with the line before it (its title)
.nr book-keep 0
.de book-vstretch
.nr book-vw (\\$1)
.if \\n[book-keep] .nr book-vw 0
.nr book-keep 0
.if \\n[book-vw] .if '\\n[.z]'' .if \\n[book-ncol]<2 .dv vstretch \\n[book-vw]
..
.\" ---------------------------------------------------------------
.\" begin: the page set, once, before the first text
.\"
.nr book-begun 0
.de book-begin
.if !\\n[book-begun] .book-begin1
..
.de book-begin1
.nr book-begun 1
.dv lang \\*[book-lang]
.pl \\n[book-ph]u
.ll \\n[book-pw]u-\\n[book-im]u-\\n[book-om]u
.lt \\n[.l]u
.ps \\n[book-ps]
.vs \\n[book-vs]u
.nr book-ll \\n[.l]
.fi
.book-fill
.mtp \\n[book-final]
.if \\n[book-final] .mte 20 20 5
.\" no paragraph's first line alone at a page's foot, nor its last alone
.\" at the next page's head (drafts too, so that they break as the book)
.wo 1
.ev fn
.book-noteenv
.ev
.ev en
.book-noteenv
.ev
.ev quote
.ft R
.book-fill
.wo 1
.mtp \\n[book-final]
.if \\n[book-final] .mte 20 20 5
.ev
.ev hd
.ft R
.ev
.wh 0 book-hd
.\" the first page began before its trap was set; the head plants the foot's
.book-hd
..
.\" the page's size in points, for tr2pdf and the viewers, on the first page
.nr book-sized 0
.de book-papersize
.nr book-sized 1
.\" in points, the nearest (A4's 841.89 is 842)
.nr book-wpt (\\n[book-pw]*72+(1i/2))/1i
.nr book-hpt (\\n[book-ph]*72+(1i/2))/1i
\X'papersize \\n[book-wpt]x\\n[book-hpt]'
.br
..
.de book-noteenv
.ft R
.ie \\n[book-nps] .ps \\n[book-nps]
.el .ps \\n[book-ps]-2
.ie \\n[book-nvs] .vs \\n[book-nvs]u
.el .vs \\n[book-vs]u-2p
.ll \\n[book-ll]u
.fi
.book-fill
.in 0
.ti 0
.mtp \\n[book-final]
.if \\n[book-final] .mte 20 20 5
..
.\"
.\" ---------------------------------------------------------------
.\" the page's top and bottom
.\"
.nr book-nohead 0	\" no running head on this page (a chapter's first), its folio at its foot
.nr book-blank 0	\" a blank page: neither
.ds book-lh
.ds book-rh
.\" The page's top: its margin. Its running head is set at its foot,
.\" when it is known whether the page opened a chapter or was left blank.
.\" A trap's requests that would break the text being set are given with
.\" the no-break control character.
.nr book-ncol 1		\" columns on the page (the index's two)
.nr book-col 1		\" the column being set
.nr book-colw 0
.nr book-gut 0
.de book-hd
.if !\\n[book-sized] .book-papersize
.\" the binding margin alternates: inner on the left of a right-hand page
.\" (one-sided, book-oneside, every page's on the left, as LaTeX's oneside)
.ie \\n[book-oneside] .po \\n[book-im]u
.el .ie o .po \\n[book-im]u
.el .po \\n[book-om]u
'sp |\\n[book-tm]u
.nr book-col 1
.nr book-po \\n[.o]
.mk book-coltop
.ns
.\" the foot's trap, lifted while the foot was set; troff sets the line
.\" that reaches a trap, then springs it, so the trap is a line of the
.\" text less a unit above the margin, and no line is set below it
.wh -\\n[book-bm]u-\\n[book-vs]u+1u book-fo
.nr book-fotrap \\n[.p]-\\n[book-bm]-\\n[book-vs]+1
.nr book-nofill 0
.if \\n[book-balance] .book-colbal
.book-fnplan
.if !\\n[book-flbusy] .book-flput
..
.\" the foot of a column: the next column, or the page's foot
.de book-fo
.if \\n[book-balance] .nr book-left -(\\n[nl]-\\n[book-coltop])
.ie \\n[book-col]<\\n[book-ncol] \{\
.	nr book-col +1
.	po +\\n[book-colw]u+\\n[book-gut]u
'	sp |\\n[book-coltop]u
.	if \\n[book-balance] .ch book-fo -\\n[book-bm]u-\\n[book-vs]u+1u
.\}
.el .book-pagefo
..
.\" the page's foot: its notes, its folio (written for mkindex as well,
.\" x X folio), the next page
.de book-pagefo
.\" not sprung again by the moves below
.ch book-fo
.\" the text ends here: where a full page's would, for tr2pdf: as low as
.\" the foot's trap lets a line be set, as LaTeX's \textheight; above
.\" notes, at the trap, a line above their top, so that the last line is
.\" as far above their rule on every page and never on it (the lowest a
.\" line may be set, their top, is a line too low for the rule's gap)
.if !\\n[book-nofill] .if \\n[book-ncol]<2 \{\
.	ie \\n[book-fotrap]<(\\n[.p]-\\n[book-bm]-\\n[book-vs]+1) .nr book-vt \\n[book-fotrap]
.	el .nr book-vt \\n[book-fotrap]+\\n[book-vs]-1
.	dv vfoot \\n[book-vt] \\n[book-vs]
.\}
.\" the page's own margin, not its last column's
.po \\n[book-po]u
.book-fnput
.ev hd
.ps \\n[book-ps]-1
.lt \\n[book-ll]u
.book-tag art
.\" (no running heads, with book-plain: the folio at the foot of every
.\" page, as LaTeX's plain page style sets it)
.if !\\n[book-blank] \{\
.	ie \\n[book-nohead]+\\n[book-plain] \{\
'	sp |\\n[.p]u-\\n[book-bm]u+0.4i
.	tl '\X^folio \\n%^\X^dest pg-\\n% page^'\\n%''
.	\}
.	el \{\
'	sp |\\n[book-tm]u-0.45i
.	\" a left-hand head too wide to leave its folio room: the right's
.	ds book-lh1 \\*[book-lh]
.	if !\\n[book-oneside] .if \w'\f[SC]\\*[book-lh]\fP'>(\\n[book-ll]-8m) \{\
.		if !\\n[book-lhsaid] .tm book: the title too wide for a running head; the chapter's set instead
.		nr book-lhsaid 1
.		ds book-lh1 \\*[book-rh]
.	\}
.	nr book-odd \\n[book-oneside]
.	if o .nr book-odd 1
.	ie \\n[book-odd] .tl '\X^folio \\n%^\X^dest pg-\\n% page^\f[SC]\\*[book-rh]\fP''\\n%'
.	el .tl '\X^folio \\n%^\X^dest pg-\\n% page^\\n%''\f[SC]\\*[book-lh1]\fP'
.	\}
.\}
.book-tag endart
.ev
.nr book-nohead 0
.nr book-blank 0
'bp
..
.\"
.\" ---------------------------------------------------------------
.\" paragraphs
.\"
.nr book-noindent 1	\" the next paragraph is not indented (after a heading)
.\" the next paragraph not indented, unless a line of text comes before
.\" it (a heading's or a display's first lines, with no .p): an input trap
.de book-noindent
.nr book-noindent 1
.it 1 book-noindent-clear
..
.de book-noindent-clear
.nr book-noindent 0
..
.de p
.br
.if \\n[book-flafter] .book-flafterput
.book-tag P
.book-vstretch 1p
.ie \\n[book-noindent] .ti 0
.el .ti \\n[book-pi]u
.nr book-noindent 0
..
.de book-blank
.book-begin
.p
..
.blm book-blank
.\"
.\" ---------------------------------------------------------------
.\" the title page
.\"
.de title
.ds book-title \\$*
.ds book-lh \\$*
.dv info Title \\$*
..
.de subtitle
.ds book-subtitle \\$*
..
.de author
.ds book-author \\$*
.dv info Author \\$*
..
.de date
.ds book-date \\$*
..
.de maketitle
.book-begin
.nr book-blank 1
.rs
.sp 2i
.\" the title and subtitle centred, filled if too long for a line, not
.\" hyphenated (as LaTeX's \maketitle)
.nr book-thy \\n[.hy]
.nh
.ad c
.book-size 2 1
.vs \\n[.s]p*12/10
.book-tag H1
\f[B]\\*[book-title]\fP
.br
.ps
.vs
.if !'\\*[book-subtitle]'' \{\
.	sp 0.3i
.	book-size 14 10
.	vs \\n[.s]p*12/10
.	book-tag P
\f[I]\\*[book-subtitle]\fP
.	br
.	ps
.	vs
.\}
.ad \\*[book-adj]
.hy \\n[book-thy]
.sp 1i
.ce 1
.book-size 14 10
.book-tag P
\\*[book-author]
.ps
.if !'\\*[book-date]'' \{\
.	sp 0.3i
.	ce 1
.	book-tag P
\\*[book-date]
.\}
.br
.book-tag end
.book-newpage 1 0
..
.\" a new page (none if this one is still empty), a right-hand one if $1
.\" and book-recto, with no running head if $2
.de book-newpage
.br
.book-flflush
.nr book-nofill 1
.bp
.if \\$1 .if \\n[book-recto] .if e \{\
.	nr book-blank 1
.	rs
.	bp
.\}
.\" this page's text flush at its foot (the page before's was not: a
.\" page still empty is not broken, so its head has not cleared this)
.nr book-nofill 0
.nr book-nohead \\$2
..
.\"
.\" ---------------------------------------------------------------
.\" the book's parts
.\"
.nr book-chapter 0 1
.nr book-section 0 1
.nr book-subsection 0 1
.nr book-numbered 1	\" chapters numbered (main matter)
.nr book-chnum 0	\" this chapter numbered, so its sections
.ds book-cur
.de frontmatter
.book-begin
.af % i
.nr book-numbered 0
..
.de mainmatter
.book-begin
.book-newpage 1 0
.af % 1
.nr % 1
.nr book-numbered 1
..
.de backmatter
.book-begin
.nr book-numbered 0
..
.de part
.book-begin
.book-newpage 1 1
.rs
.sp 2.5i
.ce 1
.book-size 16 10
.nr book-hn +1
.book-tag H1
\X^dest book-h\\n[book-hn]^\X^outline 0 \\$1^\f[B]\\$1\fP
.br
.book-tag end
.ps
.tm aux:.book-tocent part "" "\\$1" \\n% book-h\\n[book-hn]
.book-newpage 1 0
..
.\" .chapter "Title" [label] ["Short"]: Short, if given, the running head
.de chapter
.book-begin
.book-chapterhead 1 "\\$1" "\\$2" "\\$3"
..
.de chapter*
.book-begin
.book-chapterhead 0 "\\$1" "\\$2" "\\$3"
..
.\" LaTeX's chapter head's sizes, as its classes give them for the text's:
.\" Chapter N \huge, the title \Huge (24.88 points, but 20.74 for \huge
.\" under 11), each on 1.2 times its size, as far apart as the text's
.\" lines are stretched from single spacing (book-tvs; setspace's)
.de book-chlsz
.ie \\n[book-ps]<11 \{\
.	nr book-chsz \\n[book-ps]p*2074/1000
.	nr book-tisz \\n[book-ps]p*2488/1000
.\}
.el .ie \\n[book-ps]<13 \{\
.	nr book-chsz 2488p/100
.	nr book-tisz 2488p/100
.\}
.el \{\
.	nr book-chsz \\n[book-ps]p*2074/1000
.	nr book-tisz \\n[book-chsz]
.\}
.nr book-chb \\n[book-vs]
.if \\n[book-tvs] .nr book-chb \\n[book-tvs]
.nr book-chvs \\n[book-chsz]*12/10*\\n[book-vs]/\\n[book-chb]
.nr book-tivs \\n[book-tisz]*12/10*\\n[book-vs]/\\n[book-chb]
..
.de book-chapterhead
.book-newpage 1 1
.nr book-section 0
.nr book-subsection 0
.nr fn-n 0
.nr en-n 0
.ds book-rh \\$2
.if !'\\$4'' .ds book-rh \\$4
.ds book-en-chapter
.rs
.ie \\n[book-chlatex] \{\
.	book-chlsz
.	\" (LaTeX's 50 points below the text's top, where a page's first line
.	\" would be)
.	sp 50p+\\n[book-vs]u
.\}
.el .sp 1.25i
.book-tag H1
.\" the heading a destination (for the contents and references) and a
.\" bookmark, at its first line
.nr book-hn +1
.ds book-hx \X^dest book-h\\n[book-hn]^
.if !'\\$3'' .as book-hx \X^dest lab-\\$3^
.nr book-chnum \\$1&\\n[book-numbered]
.ie \\n[book-chnum] \{\
.	nr book-chapter +1
.	ds book-cur \\n[book-chapter]
.	nr book-fig 0
.	nr book-tab 0
.	as book-hx \X^outline 1 \\n[book-chapter] \\$2^
.	ie \\n[book-chlatex] \{\
.		ps \\n[book-chsz]u
.		vs \\n[book-chvs]u
.		ce 0
.		ad l
\\*[book-hx]\f[B]Chapter \\n[book-chapter]\fP
.		br
.		ad \\*[book-adj]
.		ps
.		vs
.		ds book-hx
.		sp 20p
.	\}
.	el \{\
.		ce 1
\\*[book-hx]\f[SC]Chapter \\n[book-chapter]\fP
.		ds book-hx
.		sp 0.25i
.	\}
.	tm aux:.book-tocent chapter "\\n[book-chapter]" "\\$2" \\n% book-h\\n[book-hn]
.	ds book-en-chapter Chapter \\n[book-chapter]: \\$2
.\}
.el \{\
.	as book-hx \X^outline 1 \\$2^
.	if !'\\$2'Contents' .if !\\n[book-notoc] .tm aux:.book-tocent chapter "" "\\$2" \\n% book-h\\n[book-hn]
.	ds book-en-chapter \\$2
.\}
.\" a running head too wide to leave its folio room: the chapter's number
.\" (as LaTeX's \chapter[short]{long} would be given), else none
.if \w'\s-1\f[SC]\\*[book-rh]\fP\s+1'>(\\n[book-ll]-8m) \{\
.	tm book: the running head too wide; a short title, .chapter "\\$2" label "Short" (at \\n[.c] of \\n[.F])
.	ie \\n[book-chnum] .ds book-rh Chapter \\n[book-chapter]
.	el .ds book-rh
.\}
.ie \\n[book-chlatex] \{\
.	\" (LaTeX's: \Huge bold, ragged right; 40 points below)
.	ps \\n[book-tisz]u
.	vs \\n[book-tivs]u
.	ad l
\\*[book-hx]\f[B]\\$2\fP
.	br
.	ad \\*[book-adj]
.	ds book-hx
.	ps
.	vs
.	sp 40p
.\}
.el \{\
.	ce 1
.	book-size 17 10
.	vs \\n[book-vs]u*16/10
\\*[book-hx]\f[I]\\$2\fP
.	ds book-hx
.	ps
.	vs
.	sp 0.6i
.\}
.book-tag end
.if !'\\$3'' .book-label \\$3
.book-noindent
.nr book-en-new 1
..
.de section
.book-begin
.nr book-section +1
.nr book-subsection 0
.ds book-cur \\n[book-chapter].\\n[book-section]
.br
.if \\n[book-flafter] .book-flafterput
.book-vstretch 4p
.sp 1v
.ne 4v
.ad l
.nr book-hn +1
.ds book-hx \X^dest book-h\\n[book-hn]^\X^outline 2 \\*[book-cur] \\$1^
.if !'\\$2'' .as book-hx \X^dest lab-\\$2^
.book-sectno
.book-tag H2
\\*[book-hx]\f[B]\\*[book-sn]\\$1\fP
.br
.book-tag end
.book-vstretch 1p
.ad \\*[book-adj]
.sp 0.5v
.tm aux:.book-tocent section "\\*[book-snt]" "\\$1" \\n% book-h\\n[book-hn]
.if !'\\$2'' .book-label \\$2
.book-noindent
.ns
..
.\" a section's number, before its title and in the contents, where its
.\" chapter's is (the main matter's), as its references give it
.de book-sectno
.ds book-sn
.ds book-snt
.if \\n[book-chnum] \{\
.	ds book-sn \\*[book-cur]\h'0.75m'
.	ds book-snt \\*[book-cur]
.\}
..
.de subsection
.book-begin
.nr book-subsection +1
.ds book-cur \\n[book-chapter].\\n[book-section].\\n[book-subsection]
.br
.if \\n[book-flafter] .book-flafterput
.book-vstretch 3p
.sp 0.75v
.ne 3v
.ad l
.nr book-hn +1
.ds book-hx \X^dest book-h\\n[book-hn]^\X^outline 3 \\*[book-cur] \\$1^
.if !'\\$2'' .as book-hx \X^dest lab-\\$2^
.book-sectno
.book-tag H3
\\*[book-hx]\f[I]\\*[book-sn]\\$1\fP
.br
.book-tag end
.book-vstretch 1p
.ad \\*[book-adj]
.sp 0.25v
.tm aux:.book-tocent subsection "\\*[book-snt]" "\\$1" \\n% book-h\\n[book-hn]
.if !'\\$2'' .book-label \\$2
.book-noindent
.ns
..
.\" a heading below a subsection's, as LaTeX's book sets one: not
.\" numbered, not in the contents; a label on it refers to the subsection
.de subsubsection
.book-begin
.br
.if \\n[book-flafter] .book-flafterput
.book-vstretch 2p
.sp 0.5v
.ne 3v
.ad l
.nr book-hn +1
.ds book-hx \X^dest book-h\\n[book-hn]^\X^outline 4 \\$1^
.if !'\\$2'' .as book-hx \X^dest lab-\\$2^
.book-tag H4
\\*[book-hx]\f[BI]\\$1\fP
.br
.book-tag end
.book-vstretch 1p
.ad \\*[book-adj]
.sp 0.25v
.if !'\\$2'' .book-label \\$2
.book-noindent
.ns
..
.\"
.\" ---------------------------------------------------------------
.\" lists: .list [1 a i bullet dash] ... .item ... .endlist, as LaTeX's
.\" enumerate and itemize; nested, each 2.5 ems further in, its marks
.\" hung before its items' text (1. a) i. • –); tagged L, LI, Lbl, LBody
.\"
.nr book-ld 0		\" the lists open
.de list
.book-begin
.br
.if \\n[book-flafter] .book-flafterput
.nr book-ld +1
.ds book-lt\\n[book-ld] \\$1
.if '\\$1'' .ds book-lt\\n[book-ld] bullet
.nr book-ln\\n[book-ld] 0 1
.af book-ln\\n[book-ld] 1
.if '\\$1'a' .af book-ln\\n[book-ld] a
.if '\\$1'i' .af book-ln\\n[book-ld] i
.nr book-li\\n[book-ld] 0
.if \\n[book-ld]=1 \{\
.	book-vstretch 2p
.	sp 0.5v
.\}
.book-tag end
.book-tag push L
.book-noindent
..
.\" (an item an LI of its Lbl and its LBody, the LBody pushed, so that a
.\" list within the item is in it, as PDF/UA has it)
.de item
.br
.if \\n[book-li\\n[book-ld]] \{\
.	book-tag pop
.	book-tag pop
.\}
.nr book-li\\n[book-ld] 1
.nr book-ln\\n[book-ld] +1
.ds book-lm \\(bu
.if '\\*[book-lt\\n[book-ld]]'dash' .ds book-lm \\(en
.if '\\*[book-lt\\n[book-ld]]'1' .ds book-lm \\n[book-ln\\n[book-ld]].
.if '\\*[book-lt\\n[book-ld]]'a' .ds book-lm \\n[book-ln\\n[book-ld]])
.if '\\*[book-lt\\n[book-ld]]'i' .ds book-lm \\n[book-ln\\n[book-ld]].
.if !'\\$1'' .ds book-lm \\$1
.book-vstretch 1p
.sp 0.2v
.book-tag push LI
.in \\n[book-ld]u*2.5m
.ti \\n[book-ld]u*2.5m
\X'tag Lbl'\h'-\w'\\*[book-lm]'u-0.5m'\\*[book-lm]\h'0.5m'\X'tag end'\X'tag push LBody'\c
..
.de endlist
.br
.if \\n[book-li\\n[book-ld]] \{\
.	book-tag pop
.	book-tag pop
.\}
.book-tag pop
.nr book-ld -1
.in \\n[book-ld]u*2.5m
.if \\n[book-ld]=0 \{\
.	book-vstretch 2p
.	sp 0.5v
.	in 0
.\}
.book-noindent
..
.\"
.\" ---------------------------------------------------------------
.\" block quotations and epigraphs
.\"
.de quote
.book-begin
.br
.if \\n[book-flafter] .book-flafterput
.book-tag push BlockQuote
.book-vstretch 3p
.sp 0.5v
.ev quote
.evc 0
.ps \\n[book-ps]-1
.vs \\n[book-vs]u-1.5p
.in +2m
.ll -2m
.\" the first line at the indent too (a paragraph's .ti cancelled;
.\" .ti 0 put it at the margin)
.ti +0
..
.de endquote
.br
.book-tag pop
.book-vstretch 3p
.ev
.sp 0.5v
.book-noindent
..
.de epigraph
.book-begin
.br
.if \\n[book-flafter] .book-flafterput
.book-tag push BlockQuote
.ev quote
.evc 0
.ps \\n[book-ps]-1
.vs \\n[book-vs]u-1.5p
.in \\n[book-ll]u*4/10
.\" the first line at the indent too (a paragraph's .ti cancelled;
.\" .ti 0 put it at the margin)
.ti +0
.ad l
..
.de attrib
.br
.book-tag P
.ad r
\(em\ \\$*
.br
..
.de endepigraph
.br
.book-tag pop
.book-vstretch 3p
.ev
.sp 1v
.book-noindent
..
.\"
.\" ---------------------------------------------------------------
.\" footnotes
.\"
.\" A note is set in the environment fn, diverted to a macro of its own
.\" (fn-pN, N counted through the book) and queued.  The notes go out in
.\" order: a page plans those at the queue's head that fit (book-fnplan
.\" at its head, .fe as their marks come), moving its foot up by their
.\" height; at the foot (book-fnput) are set those whose marks went out on
.\" the page, after a short rule.  A note longer than the page has room
.\" for is begun there if three of its lines fit, and goes on on the next
.\" (its rest, at the queue's head), as LaTeX splits a note.
.\"
.nr fn-n 0 1		\" the note's number (each chapter's)
.nr fn-tot 0		\" the notes so far, through the book
.nr fn-out 0		\" the last mark set (as its line goes out: \X'nr')
.nr fn-qf 1		\" the queue: the first note waiting
.nr fn-ql 0		\" the last
.nr fn-qp 0		\" the last planned for the page
.nr fn-split 0		\" the last planned is begun on the page, not set whole
.nr fn-h 0		\" the planned notes' height
.nr fn-marked 0		\" \*[fn] marked the text for the note to come
.nr fn-gap 1v		\" from the foot of the text to the rule
.\" a note's mark a link to the note (fn-N), the note's number one back
.\" to the mark (fnm-N)
.ds book-fnmk \s-3\\n[fn-n]\s+3
.ds book-fnnt \s-2\\n[fn-n]\s+2
.ds book-fnhn \\n[fn-n]
.nr book-fnhang 1	\" a note's number hung in the margin, full size
.ds fnmark \R'fn-n +1'\R'fn-tot +1'\R'fn-marked 1'\X^dest fnm-\\n[fn-tot]^\X^nr fn-out \\n[fn-tot]^\v'-0.4m'\\*[book-lks fn-\\n[fn-tot] book-fnmk]\v'0.4m'
.\" .fn ... .fe: a note; one within a note (as LaTeX's \footnote may be)
.\" is numbered after it, its mark in it, and set below it
.nr fn-in 0		\" in a note: 1; in one within it: 2
.de fn
.ie \\n[fn-in] .book-fnin
.el \{\
.	book-fn0
.	nr fn-in 1
.	nr fn-cur \\n[fn-tot]
.\}
..
.de fe
.ie \\n[fn-in]>1 .book-fein
.el \{\
.	book-fe0
.	nr fn-in 0
.\}
..
.\" a note within a note: its mark in the note's text, its own text in
.\" an environment of its own (the note's line is still being filled),
.\" planned when the note it is in ends
.de book-fnin
.nr fn-n +1
.nr fn-tot +1
.nr fn-icur \\n[fn-tot]
\X^dest fnm-\\n[fn-tot]^\v'-0.4m'\\*[book-lks fn-\\n[fn-tot] book-fnmk]\v'0.4m'
.ev fnin
.evc fn
.di fn-p\\n[fn-tot]
.nr fn-in 2
.ie \\n[book-fnhang] \X^dest fn-\\n[fn-tot]^\h'-\w'\\n[fn-n]'u-0.5m'\\*[book-lks fnm-\\n[fn-tot] book-fnhn]\h'0.5m'\c
.el \X^dest fn-\\n[fn-tot]^\v'-0.3m'\\*[book-lks fnm-\\n[fn-tot] book-fnnt]\v'0.3m'\ \c
..
.de book-fein
.br
.di
.nr fn-dn\\n[fn-icur] \\n[dn]
.ev
.nr fn-in 1
..
.de book-fn0
.book-begin
.if !\\n[fn-marked] \{\
.	nr fn-n +1
.	nr fn-tot +1
\X^dest fnm-\\n[fn-tot]^\X^nr fn-out \\n[fn-tot]^\v'-0.4m'\\*[book-lks fn-\\n[fn-tot] book-fnmk]\v'0.4m'
.\}
.nr fn-marked 0
.nr fn-tv \\n[.v]	\" the text's line, the note's mark in it
.\" the lines of the paragraph not yet set, the mark's the last of them:
.\" troff fills a paragraph at once, so they may be several (the foot
.\" finds a mark moved on after all)
.nr fn-pend \\n[.pend]
.if \\n[fn-pend]<1 .nr fn-pend 1
.ev fn
.di fn-p\\n[fn-tot]
.\" the note's number: full size, hung in the margin, its last figure
.\" half an em before the text (as Bringhurst sets them); or raised at
.\" the note's head (book-fnhang 0)
.ie \\n[book-fnhang] \X^dest fn-\\n[fn-tot]^\h'-\w'\\n[fn-n]'u-0.5m'\\*[book-lks fnm-\\n[fn-tot] book-fnhn]\h'0.5m'\c
.el \X^dest fn-\\n[fn-tot]^\v'-0.3m'\\*[book-lks fnm-\\n[fn-tot] book-fnnt]\v'0.3m'\ \c
..
.de book-fe0
.br
.di
.nr fn-dn\\n[fn-cur] \\n[dn]
.nr fn-ql \\n[fn-tot]
.\" planned for the page, with any before it waiting, if they fit below
.\" the mark's line (or three lines of the last do)
.nr fn-qp0 \\n[fn-qp]
.nr fn-i \\n[fn-qp]+1
.if !\\n[fn-split] .book-fnfe \\n[fn-i]
.if \\n[fn-qp]>\\n[fn-qp0] .ch book-fo -\\n[book-bm]u-\\n[fn-h]u-\\n[book-vs]u+1u
.if \\n[fn-qp]>\\n[fn-qp0] .nr book-fotrap \\n[.p]-\\n[book-bm]-\\n[fn-h]-\\n[book-vs]+1
.ev
.\" the notes within it go out with its mark
.if \\n[fn-tot]>\\n[fn-cur] \X^nr fn-out \\n[fn-tot]^\c
..
.de book-fnfe
.book-fnover1
.nr fn-room \\n[.p]-\\n[book-bm]-\\n[nl]-(\\n[fn-pend]*\\n[fn-tv])-\\n[fn-h]-\\n[fn-ovh]
.ie \\n[fn-dn\\$1]<=\\n[fn-room] \{\
.	nr fn-qp \\$1
.	nr fn-h +\\n[fn-dn\\$1]+\\n[fn-ovh]
.	nr fn-i \\$1+1
.	if \\n[fn-i]<=\\n[fn-tot] .book-fnfe \\n[fn-i]
.\}
.el .if \\n[fn-room]>=(3*\\n[.v]) \{\
.	nr fn-qp \\$1
.	nr fn-h +\\n[fn-room]+\\n[fn-ovh]
.	nr fn-split 1
.\}
..
.\" what a note takes besides its own height: the first, the gap and the
.\" rule, 0.4v below it; each after, 0.3v from the one before
.de book-fnover1
.ie \\n[fn-h]=0 .nr fn-ovh \\n[fn-gap]+0.4v
.el .nr fn-ovh 0.3v
..
.\" a page's head: the notes waiting planned, as many as fit, leaving
.\" the page a line of text at least (four, if the mark is still to come)
.de book-fnplan
.nr fn-h 0
.nr fn-split 0
.nr fn-qp \\n[fn-qf]-1
.if \\n[fn-qf]<=\\n[fn-ql] \{\
.	ev fn
.	book-fnplan1 \\n[fn-qf]
.	ev
.	if \\n[fn-h] .ch book-fo -\\n[book-bm]u-\\n[fn-h]u-\\n[book-vs]u+1u
.	if \\n[fn-h] .nr book-fotrap \\n[.p]-\\n[book-bm]-\\n[fn-h]-\\n[book-vs]+1
.\}
..
.de book-fnplan1
.book-fnover1
.nr fn-room \\n[.p]-\\n[book-bm]-\\n[book-tm]-\\n[book-vs]-\\n[fn-h]-\\n[fn-ovh]
.\" one whose mark is still to come leaves room for the text it is in
.if \\$1>\\n[fn-out] .nr fn-room -(4*\\n[book-vs])
.ie \\n[fn-dn\\$1]<=\\n[fn-room] \{\
.	nr fn-qp \\$1
.	nr fn-h +\\n[fn-dn\\$1]+\\n[fn-ovh]
.	nr fn-i \\$1+1
.	if \\n[fn-i]<=\\n[fn-ql] .book-fnplan1 \\n[fn-i]
.\}
.el .if \\n[fn-room]>=(3*\\n[.v]) \{\
.	nr fn-qp \\$1
.	nr fn-h +\\n[fn-room]+\\n[fn-ovh]
.	nr fn-split 1
.\}
..
.\" a page's foot: the planned notes whose marks went out on it, in the
.\" room the text left them; what does not fit waits at the queue's head
.de book-fnput
.if \\n[fn-qp]>\\n[fn-out] .nr fn-qp \\n[fn-out]
.if \\n[fn-qp]<(\\n[fn-qf]-1) .nr fn-qp \\n[fn-qf]-1
.nr fn-h 0
.if \\n[fn-qp]>=\\n[fn-qf] .book-fnsum \\n[fn-qf]
.\" (the foot's trap a line less a unit above the notes, the text's last
.\" line is no lower than their top)
.nr fn-room \\n[.p]-\\n[book-bm]-\\n[nl]
.if \\n[fn-h]>\\n[fn-room] .nr fn-h \\n[fn-room]
.if \\n[fn-qp]>=\\n[fn-qf] \{\
.	ev fn
.	nf
.	rs
.\"	the rule a line of its own: its baseline fn-gap below the text's foot
.	sp |\\n[.p]u-\\n[book-bm]u-\\n[fn-h]u+\\n[fn-gap]u-1v
\D'l 1.5i 0'
.	sp 0.4v
.\"	what does not fit above the foot waits for the next page
.	nr fn-over 0
.	wh -\\n[book-bm]u-1v+1u book-fnover
.	nr fn-first \\n[fn-qf]
.	book-fnout \\n[fn-qf]
.	ch book-fnover
.	if \\n[fn-over] \{\
.		br
.		di
.		book-fnrest
.	\}
.\"	a note the foot was reached in, continued (as itself) on the next page
.	book-tag close Note
.	fi
.	ev
.\}
.nr fn-h 0
.nr fn-split 0
.nr fn-qp \\n[fn-qf]-1
..
.\" the planned notes' height, from $1 on
.de book-fnsum
.book-fnover1
.nr fn-h +\\n[fn-dn\\$1]+\\n[fn-ovh]
.nr fn-i \\$1+1
.if \\n[fn-i]<=\\n[fn-qp] .book-fnsum \\n[fn-i]
..
.\" the planned notes from $1 on, each after the one before, until the
.\" foot is reached
.de book-fnout
.if \\$1>\\n[fn-first] .sp 0.3v
.nr fn-cur \\$1
.book-tag push Note fn-\\$1
.fn-p\\$1
.if !\\n[fn-over] \{\
.	book-tag pop
.	rm fn-p\\$1
.	nr fn-qf \\$1+1
.	if \\n[fn-qf]<=\\n[fn-qp] .book-fnout \\n[fn-qf]
.\}
..
.de book-fnover
.nr fn-over 1
.di fn-rest
..
.\" the rest of the note the foot was reached in, at the queue's head
.\" (none, if it ended there: what was diverted is no more than the
.\" space before the next)
.de book-fnrest
.ie \\n[dn]>(\\n[.v]/2) \{\
.	rn fn-rest fn-p\\n[fn-cur]
.	nr fn-dn\\n[fn-cur] \\n[dn]
.	nr fn-qf \\n[fn-cur]
.\}
.el \{\
.	rm fn-rest
.	rm fn-p\\n[fn-cur]
.	nr fn-qf \\n[fn-cur]+1
.\}
..
.\" the last page's notes, and those waiting past it
.nr book-endn 0
.de book-end
.br
.book-flflush
.nr book-nofill 1
.nr book-endn +1
.if \\n[book-endn]>1000 \{\
.	tm book: notes \\n[fn-qf] to \\n[fn-ql] never set
.	nr fn-ql \\n[fn-qp]
.	nr fn-split 0
.\}
.if (\\n[fn-ql]>\\n[fn-qp])+\\n[fn-split]+(\\n[fn-h]>(\\n[.p]-\\n[book-bm]-\\n[nl])) \{\
.	nr book-nohead 0
\&
.	bp
.	book-end
.\}
..
.em book-end
.\"
.\" ---------------------------------------------------------------
.\" endnotes, gathered for .notes, each chapter's under its name
.\"
.nr en-n 0 1
.nr en-set 0
.nr en-marked 0
.nr book-en-new 0
.nr en-tot 0
.ds book-enmk \s-3\\n[en-n]\s+3
.ds book-ennt \\n[en-n].
.ds enmark \R'en-n +1'\R'en-tot +1'\R'en-marked 1'\X^dest enm-\\n[en-tot]^\v'-0.4m'\\*[book-lks en-\\n[en-tot] book-enmk]\v'0.4m'
.de en
.book-begin
.if !\\n[en-marked] \{\
.	nr en-n +1
.	nr en-tot +1
\X^dest enm-\\n[en-tot]^\v'-0.4m'\\*[book-lks en-\\n[en-tot] book-enmk]\v'0.4m'
.\}
.nr en-marked 0
.ev en
.nr en-set 1
.da en-all
.if \\n[book-en-new] \{\
.	sp 1v
.\"	kept with its notes when they are set, not while they are gathered
\\!.ne 3v
.	in 0
.	book-tag H2
\f[I]\\*[book-en-chapter]\fP
.	sp 0.5v
.	book-tag end
.	nr book-en-new 0
.\}
.book-tag push Note en-\\n[en-tot]
.\" a hanging indent: the numbers right-aligned in a field of their own,
.\" each note's lines aligned past them, however many digits
.in 2.2m
.ti 0
\h'1.8m-\w'\\n[en-n].'u'\X^dest en-\\n[en-tot]^\\*[book-lks enm-\\n[en-tot] book-ennt]\h'0.4m'\c
..
.de ee
.br
.book-tag pop
.di
.fi
.ev
..
.de notes
.book-begin
.book-chapterhead 0 "Notes"
.if \\n[en-set] \{\
.	nr en-set 0
.	ev en
.	nf
.	en-all
.	fi
.	ev
.	rm en-all
.\}
..
.\"
.\" ---------------------------------------------------------------
.\" equations: eqn's displays, centred, a label (.EQ (1.1)) at the right
.\"
.\" the equation's depth, as eqn last measured it, when it is set
.ds .eqnbeg \R'book-eqlly \\n[bblly]'
.nr book-eqend -1
.de EQ
.\" the line before it, if it is a paragraph's (TeX's \predisplaysize)
.nr book-eqprew 0-1
.if \\n[.pend]>0 .nr book-eqprew 1
.br
.if \\n[book-eqprew]>0 .nr book-eqprew \\n[.i]+\\n[.n]
.ds book-eqlabel \\$1
.di book-eqd
.nf
..
.de EN
.br
.di
.\" the line's extra space below: the equation's depth past the line's own
.nr book-eqpost \\n[book-eqlly]-(\\n[.v]-\\n[.s]p+(\\n[.s]p*25u/100u))
.if \\n[book-eqpost]<0 .nr book-eqpost 0
.fi
.if \\n[dn] \{\
.	book-begin
.	nr book-eqw \\n[dl]
.\"	after a line of a paragraph ending 2 ems short of it, less space
.\"	above and below (TeX's \abovedisplayshortskip, 0 plus 3 points,
.\"	and \belowdisplayshortskip)
.	nr book-eqshort 0
.	if (\\n[MK]<2)&(\\n[book-eqprew]>=0) \{\
.		if \\n[book-eqprew]+2m<((\\n[book-ll]u-\\n[book-eqw]u)/2u) .nr book-eqshort 1
.	\}
.\"	lined up (eqn's lineup) with the display just before, nothing
.\"	between: TeX's \jot apart, as align's lines, not a display's space
.	ie (\\n[MK]==2)&(\\n[.d]==\\n[book-eqend]) \{\
.		sp -0.5v
.		sp 3p
.	\}
.	el \{\
.		book-vstretch 3p
.		if !\\n[book-eqshort] .sp 0.5v
.	\}
.	ne \\n[dn]u
.	nf
.\"	centred; one lined up (eqn's lineup) where the one with its mark
.\"	was, so that eqn's motion to the mark puts them one above the other
.	ie \\n[MK]==2 .nr book-eqin \\n[book-eqmkin]
.	el .nr book-eqin (\\n[book-ll]u-\\n[book-eqw]u)/2u
.	if \\n[MK]==1 .nr book-eqmkin \\n[book-eqin]
.	in \\n[book-eqin]u
.	book-eqd
.	in 0
.	fi
.	nr book-eqe \\n[.d]
.	if !'\\*[book-eqlabel]'' \{\
.\"		on the equation's baseline
.		sp -(\\n[book-eqpost]u+1v)
.		lt \\n[book-ll]u
.		tl '''\\*[book-eqlabel]'
.		sp |\\n[book-eqe]u
.	\}
.	book-vstretch 3p
.	ie \\n[book-eqshort] .sp 0.3v
.	el .sp 0.5v
.	book-noindent
.	nr book-eqend \\n[.d]
.\}
..
.\"
.\" ---------------------------------------------------------------
.\" tables (tbl's: centred by its own option, center) and pictures
.\" (pic's: centred), with space above and below
.\"
.de TS
.book-begin
.br
.book-vstretch 3p
.sp 0.5v
..
.de TE
.book-vstretch 3p
.sp 0.5v
.book-noindent
..
.de PS
.book-begin
.br
.book-vstretch 3p
.book-tag end
.book-tag push Figure
.ie '\\*[book-alt]'' \{\
.	tm book: a picture with no .alt (at \\n[.c] of \\n[.F])
.	book-tag alt Picture
.\}
.el .book-tag alt \\*[book-alt]
.ds book-alt
.\" pic gives the picture's height and width
.ie \\$1>0 \{\
.	sp 0.35v
.	nr book-pich 1
.\}
.el .nr book-pich 0
.in (\\n[.l]u-\\$2)/2u
.ne \\$1
..
.de PE
.br
.book-tag pop
.book-vstretch 3p
.in
.if \\n[book-pich] .sp 0.65v
.book-noindent
..
.\"
.\" ---------------------------------------------------------------
.\" an image, JPEG or PNG: .image file [width [height]], centred, kept on
.\" one page, described for a tagged PDF by .alt as a picture is (tr2pdf
.\" places it, x X image). What is not given (or given as "") is the
.\" image's own: its proportions; with neither, its size at its
.\" resolution (72 to the inch if it says none, as pdfTeX's); the whole
.\" no wider than the line.
.\"
.de image
.book-begin
.br
.imgsize \\$1
.nr book-iw 0
.nr book-ih 0
.if !'\\$2'' .nr book-iw (\\$2)
.if !'\\$3'' .nr book-ih (\\$3)
.if (\\n[imgw]>0)&(\\n[imgh]>0) \{\
.	nr book-ires \\n[imgres]
.	if !\\n[book-ires] .nr book-ires 72
.	if !\\n[book-iw]:\\n[book-ih] \{\
.		nr book-iw \\n[imgw]*1i/\\n[book-ires]
.		nr book-ih \\n[imgh]*1i/\\n[book-ires]
.	\}
.	if !\\n[book-iw] .nr book-iw \\n[book-ih]*\\n[imgw]/\\n[imgh]
.	if !\\n[book-ih] .nr book-ih \\n[book-iw]*\\n[imgh]/\\n[imgw]
.\}
.ie (\\n[book-iw]>0)&(\\n[book-ih]>0) \{\
.	if \\n[book-iw]>(\\n[.l]-\\n[.i]) \{\
.		nr book-ih \\n[book-ih]/10*(\\n[.l]-\\n[.i])/(\\n[book-iw]/10)
.		nr book-iw \\n[.l]-\\n[.i]
.	\}
.	book-tag end
.	book-tag push Figure
.	ie '\\*[book-alt]'' \{\
.		tm book: an image with no .alt (\\$1, at \\n[.c] of \\n[.F])
.		book-tag alt Image
.	\}
.	el .book-tag alt \\*[book-alt]
.	ds book-alt
.	ne \\n[book-ih]u+1v
.\"	below what is above it, its descenders cleared (its top would be at
.\"	the line's baseline); first in a float, at its top
.	if \\n[.d]>0 .sp 0.3v
.	sp \\n[book-ih]u-1v
.	nf
\h'(\\n[.l]u-\\n[.i]u-\\n[book-iw]u)/2u'\X'image \\$1 \\n[book-iw] \\n[book-ih]'
.	fi
.	book-tag pop
.\}
.el .tm book: .image \\$1: no size given, and none read from it (at \\n[.c] of \\n[.F])
..
.\"
.\" ---------------------------------------------------------------
.\" floats: a figure or a table with its caption, diverted in its own
.\" environment (a paragraph it is in goes on unbroken); set where it is
.\" if nothing waits and it fits there, between paragraphs; else at the
.\" top of the next page, as many waiting as take 7/10 of it, the first
.\" whatever its size; any still waiting when a chapter ends, before it
.\" ends.  Its number the chapter's and its own (1.2), in the lists of
.\" figures and tables; its label's \*[ref] the number, \*[pageref] the
.\" page it is set on.
.\"
.nr book-flnext 1	\" the next float's diversion, book-fl<n>
.nr book-flfirst 1	\" the first waiting
.nr book-flbusy 0	\" floats being set: the head sets none
.nr book-flafter 0	\" a float to set after the paragraph it was written in
.nr book-fig 0 1
.nr book-tab 0 1
.nr lof-fig-set 0
.nr book-notoc 0
.nr lof-tab-set 0
.de figure
.book-float fig Figure "\\$1"
..
.de table
.book-float tab Table "\\$1"
..
.de endfigure
.book-flend
..
.de endtable
.book-flend
..
.de book-float
.book-begin
.ds book-flk \\$1
.ds book-flname \\$2
.ds book-fllab \\$3
.ev fl
.evc 0
.ft R
.in 0
.ti 0
.di book-fl\\n[book-flnext]
.book-tag push Div
..
.\" its caption, numbered; above what it is captioning (nothing set yet)
.\" or below it
.de caption
.br
.nr book-\\*[book-flk] +1
.ie \\n[book-chnum] .ds book-flno \\n[book-chapter].\\n[book-\\*[book-flk]]
.el .ds book-flno \\n[book-\\*[book-flk]]
.nr book-flabove \\n[.d]=0
.if !\\n[book-flabove] .sp 0.5v
.book-tag Caption
.ps \\n[book-ps]-1
.vs \\n[book-vs]u-1p
.ds book-flcap \f[B]\\*[book-flname]\~\\*[book-flno].\fP\~\\$*
.ds book-flx \X^dest book-fl\\*[book-flk]\\*[book-flno]^
.if !'\\*[book-fllab]'' .as book-flx \X^dest lab-\\*[book-fllab]^
.\" a line centred, more filled
.ie \w'\\*[book-flcap]'<=\\n[.l] \{\
.	ce 1
\\*[book-flx]\\*[book-flcap]
.\}
.el \\*[book-flx]\\*[book-flcap]
.br
.book-tag end
\\!.book-flmark \\*[book-flk] \\*[book-flno] "\\*[book-fllab]" "\\$*"
.ps
.vs
.if \\n[book-flabove] .sp 0.5v
..
.\" a caption gone out: its page, for the lists and its label
.de book-flmark
.tm aux:.book-lofent \\$1 "\\$2" "\\$4" \\n% book-fl\\$1\\$2
.if !'\\$3'' \{\
.	tm aux:.ds ref-\\$3 \\$2
.	tm aux:.ds pageref-\\$3 \\n%
.\}
..
.de book-flend
.br
.book-tag pop
.di
.ev
.nr book-flh\\n[book-flnext] \\n[dn]
.nr book-flnext +1
.\" here: nothing waits, between paragraphs, and room for it and a line;
.\" written in a paragraph, after it, if there is room then (as near as
.\" LaTeX's [h] can be, a paragraph not broken for it)
.ie (\\n[book-flfirst]=(\\n[book-flnext]-1))&(\\n[.k]=0)&((\\n[dn]+2v)<\\n[.t]) \{\
.	book-vstretch 3p
.	sp 0.75v
.	book-flout
.	book-vstretch 3p
.	sp 0.75v
.\}
.el .if (\\n[book-flfirst]=(\\n[book-flnext]-1))&(\\n[.k]>0) .nr book-flafter \\n[book-flnext]-1
..
.\" the paragraph a float was written in ended: the float after it, if it
.\" still waits (the page did not end first) and there is room
.de book-flafterput
.if \\n[book-flafter]=\\n[book-flfirst] .if (\\n[book-flh\\n[book-flfirst]]+2v)<\\n[.t] \{\
.	book-vstretch 3p
.	sp 0.75v
.	book-flout
.	book-vstretch 3p
.	sp 0.75v
.\}
.nr book-flafter 0
..
.\" the first waiting float set here
.de book-flout
.nr book-flk \\n[book-flfirst]
.ev fl
.nf
.book-fl\\n[book-flk]
.ev
.rm book-fl\\n[book-flk]
.nr book-flfirst +1
..
.\" at a page's top (the head's): those waiting that fit
.\" (in the head, perhaps sprung in a paragraph: no breaks)
.de book-flput
.if \\n[book-ncol]<2 .if \\n[book-flfirst]<\\n[book-flnext] \{\
.	nr book-flbusy 1
.	rs
.	nr book-flroom \\n[.t]*7/10
.	book-flput1 1
.	book-vstretch 4p
'	sp 1v
.	ns
.	nr book-flbusy 0
.\}
..
.de book-flput1
.nr book-flk \\n[book-flfirst]
.if \\$1+(\\n[book-flh\\n[book-flk]]<=\\n[book-flroom]) \{\
.	nr book-flroom -\\n[book-flh\\n[book-flk]]+1v
.	if !\\$1 \{\
.		book-vstretch 3p
'		sp 1v
.	\}
.	book-flout
.	if \\n[book-flfirst]<\\n[book-flnext] .book-flput1 0
.\}
..
.\" a chapter's end: those still waiting, each where it fits
.de book-flflush
.if \\n[book-flfirst]<\\n[book-flnext] \{\
.	br
.	nr book-flbusy 1
.	nr book-nofill 1
.	sp 1v
.	ne \\n[book-flh\\n[book-flfirst]]u
.	nr book-nofill 1
.	book-flout
.	nr book-flbusy 0
.	book-flflush
.\}
..
.\" the lists of figures and tables
.de book-lofent
.nr lof-\\$1-set 1
.am lof-\\$1-calls book-x
.book-tocline figure "\\$2" "\\$3" \\$4 \\$5
.book-x
..
.de listoffigures
.book-lof fig "List of Figures"
..
.de listoftables
.book-lof tab "List of Tables"
..
.\" (as the contents, not in them)
.de book-lof
.book-begin
.nr book-notoc 1
.book-chapterhead 0 "\\$2"
.nr book-notoc 0
.if \\n[lof-\\$1-set] \{\
.	ad l
.	if \\n[book-tvs] .vs \\n[book-tvs]u
.	book-tag push TOC
.	lof-\\$1-calls
.	book-tag pop
.	vs \\n[book-vs]u
.	in 0
.	ad \\*[book-adj]
.\}
..
.\"
.\" ---------------------------------------------------------------
.\" refer's citations and bibliography
.\"
.ds book-citenotes fn	\" notes citing: fn (footnotes) or en (endnotes)
.de ]fn
.ie '\\*[book-citenotes]'en' .en
.el .fn
..
.de ]fe
.ie '\\*[book-citenotes]'en' .ee
.el .fe
..
.de ]bb
.book-chapterhead 0 "Bibliography"
.ad l
.\" set ragged, so not hyphenated: nothing gained by it
.nr book-hy0 \\n[.hy]
.nh
..
.de ]be
.br
.book-tag P
.in 2m
.ti -2m
.sp 0.25v
..
.de ]bz
.br
.book-tag end
.in 0
.ad \\*[book-adj]
.hy \\n[book-hy0]
..
.\"
.\" ---------------------------------------------------------------
.\" the index: .index puts its entry where the text it is on is set, as
.\" x X idx in troff's output, mkindex(1) sorts them with each page's
.\" folio, and .printindex reads what mkindex made (the file the string
.\" book-ind names; book(1) runs mkindex, and sets the book again)
.\"
.de index
\\X^idx \\$*^\c
..
.de printindex
.book-begin
.book-chapterhead 0 "Index"
.nr book-gut 0.25i
.nr book-colw (\\n[book-ll]-\\n[book-gut])/2
.ll \\n[book-colw]u
.ps \\n[book-ps]-2
.vs \\n[book-vs]u-2p
.ad l
.nh
.in 0
.mk book-coltop
.nr book-col 1
.nr book-ncol 2
.\" set in a column's measure, kept, then put out in columns: its height
.\" known, the last page's are balanced
.di book-ixd
.if !'\\*[book-ind]'' .so \\*[book-ind]
.br
.di
.nr book-left \\n[dn]
.nf
.in 0
.ti 0
.mk book-coltop
.nr book-col 1
.nr book-ncol 2
.nr book-balance 1
.book-colbal
.book-tag push Index
.book-ixd
.br
.book-tag pop
.rm book-ixd
.nr book-balance 0
.\" one column again, or the last page's foot would move to the next
.\" column and troff, ending, set another page
.nr book-ncol 1
.fi
..
.\" at a page's first column: if what is left fits in this page's two,
.\" the first ends at half of it (in whole lines; troff sets the line
.\" that reaches the trap, so the trap is a line less a unit above)
.nr book-balance 0
.nr book-left 0
.de book-colbal
.nr book-room \\n[.p]-\\n[book-bm]-\\n[book-coltop]
.if \\n[book-left]<=(2*\\n[book-room]) \{\
.	nr book-half (\\n[book-left]/\\n[.v]+1)/2*\\n[.v]
.	if \\n[book-half]<\\n[.v] .nr book-half \\n[.v]
.	ch book-fo \\n[book-coltop]u+\\n[book-half]u-\\n[.v]u+1u
.\}
..
.\" an entry at its level (0 the heading, 1 and 2 subentries), its lines
.\" after the first indented past the deepest
.de book-ix
.br
.book-tag P
.in 3m
.ti \\$1m
..
.\" between the entries of one letter and the next
.de book-ixgroup
.br
.sp 1v
..
.\"
.\" ---------------------------------------------------------------
.\" cross-references and the contents, from the first pass
.\"
.\" .label: its place a destination (lab-name) where it is in the text
.de book-label
.tm aux:.ds ref-\\$1 \\*[book-cur]
.tm aux:.ds pageref-\\$1 \\n%
..
.de label
.book-label \\$1
\\X^dest lab-\\$1^\c
..
.\" links: \*[book-lks dest string], the string's text a link to the
.\" destination; \*[book-pl folio text], the text a link to the page
.de book-lks
\R'book-lkw \w'\\*[\\$2]'u'\R'book-lkh \\n[.v]'\v'0.25m'\X^link "#\\$1" \\n[book-lkw] -\\n[book-lkh]^\v'-0.25m'\\*[\\$2]
..
.chop book-lks
.de book-pl
\R'book-lkw \w'\\$2'u'\R'book-lkh \\n[.v]'\v'0.25m'\X^link "#pg-\\$1" \\n[book-lkw] -\\n[book-lkh]^\v'-0.25m'\\$2
..
.chop book-pl
.\" the contents' line from here a link to the heading
.de book-tl
\R'book-lkw \\n[book-ll]-\\n[.i]'\R'book-lkh \\n[.v]'\v'0.25m'\X^link "#\\$1" \\n[book-lkw] -\\n[book-lkh]^\v'-0.25m'
..
.chop book-tl
.ds ref \\*[book-lks lab-\\$1 ref-\\$1]
.ds pageref \\*[book-lks lab-\\$1 pageref-\\$1]
.\" an entry, kept for .contents
.nr toc-set 0
.de book-tocent
.nr toc-set 1
.am toc-calls book-x
.book-tocline \\$1 "\\$2" "\\$3" \\$4 \\$5
.book-x
..
.\" a line of the contents: its title, leaders to a stop the same on every
.\" line (so their dots line up), the page at the right margin; tab stops
.\" are measured from the indent, so an indented line's are moved back
.char \[book-ld] \h'0.18m'.\h'0.18m'
.de book-tocline
.nf
.book-tag TOCI
.in 0
.ti 0
.lc \[book-ld]
.ie '\\$1'part' \{\
.	sp 1v
\\*[book-tl \\$5]\f[B]\\$3\fP
.\}
.el .ie '\\$1'chapter' \{\
.	\" (with book-chlatex, as LaTeX's book class: an em above, bold, the
.	\" number in a box 1.5 ems wide, no leaders)
.	ie \\n[book-chlatex] \{\
.		sp 1m
.		ft B
.		lc
.		ie !'\\$2'' .book-tocent1 0 1.5m "\\$2" "\\$3" \\$4 \\$5
.		el .book-tocent1 0 0 "" "\\$3" \\$4 \\$5
.		ft
.	\}
.	el \{\
.		sp 0.5v
.		ie !'\\$2'' .book-tocent1 0 1.8m "\\$2." "\\$3" \\$4 \\$5
.		el .book-tocent1 0 0 "" "\\$3" \\$4 \\$5
.	\}
.\}
.\" (LaTeX's indents and numbers' widths)
.el .ie '\\$1'subsection' .book-tocent1 3.8m 3.2m "\\$2" "\\$3" \\$4 \\$5
.el .ie '\\$1'figure' .book-tocent1 1.5m 2.3m "\\$2" "\\$3" \\$4 \\$5
.el \{\
.	ie !'\\$2'' .book-tocent1 1.5m 2.3m "\\$2" "\\$3" \\$4 \\$5
.	el .book-tocent1 1.5m 0 "" "\\$3" \\$4 \\$5
.\}
.br
.lc .
.fi
..
.\" an entry: at the indent $1, its number $3 in a box $2 wide, its
.\" title $4; a title too long for one line (with room for leaders and
.\" its page) filled to 2.55 ems short of the page's measure, as LaTeX's
.\" contents are, hung after the number; the leaders from its last line
.\" to its page $5's box, 1.55 ems at the margin (LaTeX's \@pnumwidth);
.\" the whole a link to $6
.de book-tocent1
.in \\$1
.ta \\n[book-ll]u-\\$1-1.55m \\n[book-ll]u-\\$1R
.ie \w'\\$3\h'\\$2-\w'\\$3'u'\\$4'<(\\n[book-ll]-\\$1-4.5m) \\*[book-tl \\$6]\\$3\h'\\$2-\w'\\$3'u'\\$4\a\t\\$5
.el \{\
.	\" room for its lines, the last of them reaching the page's foot at
.	\" most (counted short of the measure, so as not to count too few);
.	\" the foot a line lower while they are set,
.	\" so that the last does not spring it before its leaders go back up
.	\" beside it, and sprung after, if the last reached it
.	nr book-tln \w'\\$3\h'\\$2-\w'\\$3'u'\\$4'/(\\n[book-ll]-\\$1-\\$2-4m)+1
.	ne \\n[book-tln]v-\\n[.v]u+1u
.	ch book-fo \\n[book-fotrap]u+\\n[.v]u
.	in \\$1+\\$2
.	ti \\$1
.	ll \\n[book-ll]u-2.55m
.	fi
.	ad l
.	nr book-tly \\n[nl]
\\*[book-tl \\$6]\\$3\h'\\$2-\w'\\$3'u'\\$4
.	br
.	nf
.	ll \\n[book-ll]u
.	nr book-tlw \\n[.n]
.	\" (one line, its width from the number, not after it)
.	nr book-tly \\n[nl]-\\n[book-tly]
.	if (\\n[book-tly]>0)&(\\n[book-tly]<(2*\\n[.v])) .nr book-tlw -(\\$2)
.	\" (and short of the leaders' stop, else the tab passes it: a line
.	\" its spaces shrank to fit is narrower than \n[.n] says)
.	if \\n[book-tlw]>(\\n[book-ll]-\\$1-\\$2-1.55m) .nr book-tlw \\n[book-ll]-\\$1-\\$2-1.55m-1
.	sp -1v
.	ta \\n[book-ll]u-\\$1-\\$2-1.55m \\n[book-ll]u-\\$1-\\$2R
\h'\\n[book-tlw]u'\a\t\\$5
.	ch book-fo \\n[book-fotrap]u
.	if \\n[nl]>=\\n[book-fotrap] .book-fo
.	ad pb
.\}
..
.de contents
.book-begin
.book-chapterhead 0 "Contents"
.if \\n[toc-set] \{\
.	ad l
.	if \\n[book-tvs] .vs \\n[book-tvs]u
.	book-tag push TOC
.	toc-calls
.	book-tag pop
.	vs \\n[book-vs]u
.	in 0
.	ad pb
.\}
..
.\" the first pass's knowledge
.if !'\*[book-aux]'' .so \*[book-aux]
