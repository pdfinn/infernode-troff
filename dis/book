#!/dis/sh
# book - a book written with troff's macros -mbook, as PDF
#
#	book [-f] [-l] [-m macros] [-p works.bib] [-S style] [-o book.pdf] book.ms
#
# -m names the macros, -mbook's or a class built on them: article
# (-marticle, a journal's article in two columns), memo (-mmemo).
# Citations are set by refer(1) from the database, in the style
# (chicago); pictures, chess diagrams, tables and equations by pic(1),
# chess(1), tbl(1) and eqn(1),
# if there are any (eqn with its settings for the fonts,
# /lib/troff/eqnrc); the book by troff(1) -mbook, as
# often as its table of contents and references need to be set again
# (they come from the pass before, through book.aux); then the PDF by
# tr2pdf(1), tagged for those who hear it read (PDF/UA-1). troff's output
# is kept as book.out, for the document views.
# -f sets it as it goes to press (the register book-final): with
# microtypography, its punctuation hanging into the margins; without
# it, a draft, set as before and sooner.
# A book with an index (.printindex) has it made by mkindex(1) from each
# pass's output, into book.ind, and is set again until that settles too.
# -l sets it to be looked at as it is written (a document view's live
# preview): troff's output to standard output, no PDF, no index made.
load std

bib=()
style=chicago
macros=book
out=()
final=0
look=0
args=$*
while {! ~ $#args 0 1 && ~ ${hd $args} -*} {
	o=${hd $args}
	args=${tl $args}
	if {~ $o -p} {bib=${hd $args}; args=${tl $args}}
	if {~ $o -S} {style=${hd $args}; args=${tl $args}}
	if {~ $o -m} {macros=${hd $args}; args=${tl $args}}
	if {~ $o -o} {out=${hd $args}; args=${tl $args}}
	if {~ $o -f} {final=1}
	if {~ $o -l} {look=1}
}
~ $#args 1 || {echo 'usage: book [-f] [-l] [-m macros] [-p works.bib] [-S style] [-o book.pdf] book.ms' >[1=2]; raise usage}
src=$args
stem=`{echo $src | sed 's/\.[^.\/]*$//'}
aux=$stem.aux
~ $#out 0 && out=$stem.pdf
tr=$stem.out	# troff's output, kept for viewing it
err=$stem.log
new=$stem.aux.new
ind=$stem.ind
indnew=$stem.ind.new

# pictures, chess diagrams, tables and equations: pic, chess, tbl, eqn
# (after its settings for the fonts), if there are any
boards=0
grep -s '^\.CB' $src && boards=1
pics=0
grep -s '^\.PS' $src && pics=1
tbls=0
grep -s '^\.TS' $src && tbls=1
math=0
grep -s '^\.EQ' $src && math=1
index=0
grep -s '^\.printindex' $src && index=1
~ $look 1 && index=0

fn input {
	if {~ $math 1} {cat /lib/troff/eqnrc $src} {cat $src}
}
fn cite {
	if {~ $#bib 0} {cat} {refer -p $bib -S $style}
}
fn boards {
	if {~ $boards 1} {chess} {cat}
}
fn pics {
	if {~ $pics 1} {pic} {cat}
}
fn tbls {
	if {~ $tbls 1} {tbl -t} {cat}
}
fn eqns {
	if {~ $math 1} {eqn -t} {cat}
}
# the preprocessors once (what they make depends on no pass), then troff
# as often as the book needs.  pic before chess: a board is set as pic
# sets a picture, between .PS w h and .PE, which pic would read again.
pre=$stem.pre
input | cite | pics | boards | tbls | eqns >$pre
fn pass {
	troff -m^$macros '-rbook-final='^$final '-dbook-aux='^$aux '-dbook-ind='^$ind $pre >$tr >[2]$err
	grep '^aux:' $err | sed 's/^aux://' >$new
	if {~ $index 1} {mkindex -l $tr >$indnew} {cp $ind $indnew}
}

ftest -f $aux || echo -n >$aux
ftest -f $ind || echo -n >$ind
done=0
for n in 1 2 3 4 {
	if {~ $done 0} {
		pass
		same=0
		if {cmp -s $aux $new >/dev/null >[2]/dev/null} {
			if {cmp -s $ind $indnew >/dev/null >[2]/dev/null} {same=1}
		}
		if {~ $same 1} {
			done=1
		} {
			cp $new $aux
			cp $indnew $ind
		}
	}
}
grep -v '^aux:' $err >[1=2]
if {~ $look 1} {
	cat $tr
	rm -f $err $new $indnew $pre $tr
	exit
}
# tagged by -mbook (x X tag), the PDF claims PDF/UA-1, unless a picture
# was left with nothing to describe it to those who cannot see it
ua=-u
grep -s 'a picture with no .alt' $err && ua=()
tr2pdf $ua $tr >$out
rm -f $err $new $indnew $pre
