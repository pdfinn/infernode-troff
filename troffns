#!/dis/sh.dis
# troffns [dir] - put the troff package into this name space.
#
# Run it with run, so that its binds are made in the calling shell's
# name space:
#	run /n/local/home/you/src/troffpkg/troffns
# dir is the package as Inferno sees it; without it, the directory
# this script is in.  Each of the package's directories is bound after
# InferNode's own (bind -a): its commands in /dis, its macros and
# device descriptions in /lib/tmac and /lib/troff, its fonts in
# /fonts/libertinus, its pages in /man.  Nothing of InferNode's is
# hidden and nothing is copied: delete the line that runs this to
# remove it.
load std
# $0 inside a `{} block is the block, so name the script first
self=$0
p=`{echo $self | sed 's,/[^/]*$,,'}
if {! ~ $#* 0} {
	p=$1
}
if {! ftest -f $p^/dis/troff.dis} {
	echo 'troffns: no '^$p^'/dis/troff.dis: build it first (mk install on the host)' >[1=2]
	raise 'fail:not built'
}
dirs=(dis dis/lib dis/xenith dis/xenith/doc dis/refer lib lib/tmac lib/tmac/me lib/troff lib/troff/devutf lib/troff/hyph fonts fonts/libertinus man man/1 man/6)
# the directories InferNode has, found before any is bound: one it
# lacks is reached through its parent's bind, or not at all
have=()
for d in $dirs {
	if {ftest -d /$d} {have=($have $d)}
}
for d in $have {
	if {ftest -d $p/$d} {bind -a $p/$d /$d}
}
if {! ftest -d /man} {
	echo 'troffns: this InferNode has no /man; the manual is in '^$p^'/man' >[1=2]
}
# Xenith's kinds of document: troff's added to InferNode's
# /lib/xenith/doctypes, unless it has them, in a copy bound over it
# (a file is not a directory, to be bound after).  Xenith reads it when
# it starts, so this reaches a Xenith started after it: run troffns from
# the standalone Xenith's start-up file, lib/xen/profile.
dt=/lib/xenith/doctypes
if {ftest -f $dt} {
	if {! grep -s trodoc $dt} {
		mine=/tmp/troffns.^`{cat /dev/user}^.doctypes
		if {cat $dt $p/lib/troff/xenith.doctypes > $mine} {
			bind $mine $dt
		} {
			echo 'troffns: cannot write '^$mine^': Xenith will not show troff''s documents' >[1=2]
		}
	}
}
status ''
